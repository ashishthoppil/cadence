# Edge Function secrets. Copy to supabase/functions/.env, fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

# Long random string. Also stored in Vault as `cadence_internal_secret` for the cron jobs.
#   openssl rand -hex 32
CADENCE_INTERNAL_SECRET=

# Where the web app is deployed (no trailing slash). Used for links in emails and checkout.
SITE_URL=https://cadence.example.com

# OpenAI — writes the posts. Model can be overridden per workspace in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Resend — sends the daily email. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Cadence <cadence@yourdomain.com>

# Gemini — short videos (Image + Videos plan). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# Pixabay — stock photos for brands that pick "Stock photos". Free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional: Pexels also works if you already have a key (Pexels has paused new keys).
# PEXELS_API_KEY=

# Dodo Payments. DODO_ENV is "test" or "live". Create four subscription products in Dodo
# (each plan in INR and USD) and paste their IDs below.
DODO_ENV=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_IMAGE_INR=
DODO_PRODUCT_IMAGE_USD=
DODO_PRODUCT_VIDEO_INR=
DODO_PRODUCT_VIDEO_USD=
